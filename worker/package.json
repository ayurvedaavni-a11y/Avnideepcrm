{
  "name": "avnideep-crm-api",
  "private": true,
  "version": "1.0.0",
  "description": "AVNIDEEP CRM PRO online API — Cloudflare Worker + D1 (new account)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:local": "sh ./scripts/migrate-local.sh",
    "migrate:remote": "sh ./scripts/migrate-remote.sh",
    "db:create": "wrangler d1 create avnideep-crm"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "typescript": "^5.5.4",
    "wrangler": "^4.19.0"
  }
}
